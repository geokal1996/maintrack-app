# Antigrapse auto to arxeio se ".env" (sto idio simeio) kai bale tis PRAGMATIKES times sou.
# To ".env" den anevainei pote sto GitHub (einai sto .gitignore).
#
# Se PowerShell:  Copy-Item .env.example .env

# --- SQL Server se Docker ---
# Kodikos gia ton diaxeiristi ("sa") tou SQL Server container.
# Prepei na exei toulaxiston 8 xaraktires, kefalaia, peza, arithmo kai symbolo.
SA_PASSWORD=YourStrong!Passw0rd

# --- Xristis pou xrisimopoiei i efarmogi ---
# Dimiourgeitai automata mesa sto container kai exei dikaiomata MONO sti vasi
# "maintrackdb" - oxi se olo ton server, opos o "sa".
DB_USERNAME=maintrack_app
DB_PASSWORD=Maintrack!App2026

# --- JWT ---
# To mystiko kleidi me to opoio ypografontai ta tokens syndesis.
# ALAXE TO. Prepei na einai megalo kai tyxaio - toulaxiston 32 xaraktires.
# An to kleidi einai gnosto, opoiosdipote mporei na ftiaxei token kai na mpei
# stin efarmogi san diefthintis, xoris na kserei kanenan kodiko.
#
# Gia na ftiaxeis ena tyxaio se PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=alakse-me-me-ena-megalo-tyxaio-kleidi-toulaxiston-32-xaraktiron
