{
  "info": {
    "name": "Maintrack API",
    "description": "Postman collection gia to Maintrack (Sistima Katagrafis Vlavon & Syntirisis) - Coding Factory Final Project. Perilamvanei: login me 3 diaforetikous rolous (MANAGER/SUPERVISOR/TECHNICIAN), CRUD gia mihanes/vlaves/xristes, kai negative tests pou epivevaionoun oti oi periorismoi dikaiomaton doulevoun sosta.\n\nProapaitoumeno: to backend na trexei sto localhost:8080 kai to seed data na exei trexei toulaxiston mia fora (etsi yparxoun oi xristes admin/m.nikolaou/k.konstantinou).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "managerToken", "value": "" },
    { "key": "supervisorToken", "value": "" },
    { "key": "technicianToken", "value": "" },
    { "key": "technicianUserId", "value": "" },
    { "key": "machineId", "value": "" },
    { "key": "existingMachineId", "value": "" },
    { "key": "faultId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login - MANAGER (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Epistrafike token', function () { pm.expect(data.token).to.be.a('string'); });",
                  "pm.test('O rolos einai MANAGER', function () { pm.expect(data.role).to.eql('MANAGER'); });",
                  "pm.collectionVariables.set('managerToken', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "response": []
        },
        {
          "name": "Login - SUPERVISOR (m.nikolaou)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('O rolos einai SUPERVISOR', function () { pm.expect(data.role).to.eql('SUPERVISOR'); });",
                  "pm.collectionVariables.set('supervisorToken', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"m.nikolaou\",\n  \"password\": \"Manager123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
